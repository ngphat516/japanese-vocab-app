DATABASE_URL=postgresql+asyncpg://vocab:vocab@localhost:5432/vocab
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
CORS_ORIGINS=["http://localhost:3000"]
RATE_LIMIT_ENABLED=true
# Optional: keep an existing local Postgres volume when reorganizing the repository.
# POSTGRES_VOLUME_NAME=japanese-vocab-app_postgres_data
# POSTGRES_VOLUME_EXTERNAL=true
IMPORT_MODE=async
